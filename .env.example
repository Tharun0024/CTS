# Version-1 / Decision Agent LLM configuration
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# RAG LLM API configuration
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_API_URL=https://api.openai.com/v1

# RAG cache and model storage
HF_HOME=E:\RAG\cache
TRANSFORMERS_CACHE=E:\RAG\cache\transformers
HF_DATASETS_CACHE=E:\RAG\cache\datasets
TORCH_HOME=E:\RAG\cache\torch

# Debug mode
DEBUG=false

# Phase 7 local-first storage (no cloud service is ever required):
#   sqlite  (default) - claims/simulations persist to the local SQLite DB
#                       (agent2/workspace/agent2.db) via repository interfaces
#   memory            - ephemeral in-process stores (nothing persisted)
CTS_STORAGE=sqlite
# Local directory for raw uploaded document bytes (LocalFileDocumentStore).
CTS_DOCUMENT_DIR=data/documents